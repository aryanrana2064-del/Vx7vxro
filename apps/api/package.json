{
  "name": "@vxqor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:node": "tsx watch src/dev-node.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply vxqor --local",
    "db:migrate:remote": "wrangler d1 migrations apply vxqor --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@vxqor/shared": "*",
    "hono": "^4.6.14",
    "otpauth": "^9.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.10.0"
  }
}
